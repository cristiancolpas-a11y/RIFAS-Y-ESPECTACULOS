rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "cristian.colpas@logisticos.co" ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "admin")
      );
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUsuario(data) {
      return data.email is string && 
             data.role in ['admin', 'participante'];
    }

    function isValidRifa(data) {
      return data.nombre is string && 
             data.precioPorNumero is number && data.precioPorNumero > 0 &&
             data.cantidadNumeros is number && data.cantidadNumeros > 0 &&
             data.estado in ['activa', 'finalizada'] &&
             data.fechaSorteo != null;
    }

    function isValidCompra(data) {
      return (data.usuarioId == request.auth.uid || data.usuarioId == 'invitado' || (isAdmin() && data.usuarioId == 'admin_manual')) &&
             data.rifaId is string &&
             data.numeros is list && data.numeros.size() > 0 &&
             data.montoTotal is number &&
             data.estadoPago in ['pendiente', 'validado', 'rechazado'];
    }

    // Collection Groups
    match /{path=**}/compras/{compraId} {
      allow get: if (isSignedIn() && resource.data.usuarioId == request.auth.uid) || resource.data.usuarioId == 'invitado' || isAdmin();
      allow list: if isAdmin() || 
                   (isSignedIn() && resource.data.usuarioId == request.auth.uid) ||
                   (resource.data.usuarioId == 'invitado');
      allow create: if (isSignedIn() || incoming().usuarioId == 'invitado') && isValidCompra(incoming()) && (incoming().estadoPago == 'pendiente' || isAdmin());
      allow update: if isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['estadoPago', 'validadoAt', 'validadoBy']) ||
        isAdmin() // Full update for admin if needed
      );
    }

    match /{path=**}/numeros_reservados/{numero} {
      allow get: if true;
      allow list: if true;
      allow create: if (isSignedIn() || incoming().usuarioId == 'invitado') && (incoming().usuarioId == (request.auth != null ? request.auth.uid : 'invitado') || isAdmin());
      allow delete: if isAdmin();
    }

    // Collection: Usuarios
    match /usuarios/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if (isSignedIn() && request.auth.uid == userId) && (incoming().role == 'participante' || isAdmin());
      allow update: if (isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])) || isAdmin();
    }

    // Collection: Rifas
    match /rifas/{rifaId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() && isValidRifa(incoming());
      allow update: if isAdmin() && isValidRifa(incoming());
      allow delete: if isAdmin();
    }
  }
}
